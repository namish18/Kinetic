# Copy this file to backend/.env and replace the values marked below.
# The server refuses to start if a required value is missing, weak or still a placeholder.
#
# Generate each secret separately, because they must all be different:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# ---------- Required ----------

MONGODB_URI=mongodb://localhost:27017/kinetic

# From your GitHub OAuth app: https://github.com/settings/developers
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret

SESSION_SECRET=replace_me_with_a_random_secret
JWT_SECRET=replace_me_with_a_random_secret

# Verifies incoming GitHub webhooks. Enter the same value in your GitHub webhook settings.
GITHUB_WEBHOOK_SECRET=replace_me_with_a_random_secret

# Every user's did:key is derived from this value.
# Back it up, and do not change it once users exist: new derivations would no longer match their stored DIDs.
DID_SEED_SECRET=replace_me_with_a_random_secret

# ---------- Optional ----------

# PORT=5000
# NODE_ENV=development
# FRONTEND_URL=http://localhost:3000
# GITHUB_CALLBACK_URL=http://localhost:5000/api/auth/github/callback

# Raises GitHub API rate limits for contribution scoring.
# GITHUB_PAT=

# Flow testnet. Without FLOW_PRIVATE_KEY the server runs but on-chain payout transactions fail.
# FLOW_ADDRESS=0x0000000000000000
# FLOW_CONTRACT_ADDRESS=0x0000000000000000
# FLOW_PRIVATE_KEY=

# Historical reputation weights.
# REPUTATION_ALPHA=10
# REPUTATION_BETA=25
# REPUTATION_GAMMA=30
# REPUTATION_DELTA=20
